@using System.Drawing
@using CMLabExtim.CustomClasses
@using DevExpress.Office.Utils
@using LabExtimOperator.Models
@using LabExtimOperator.Controllers
@{

    var context = new DLLabExtim.QuotationDataContext();
    LeaveRequestControllerSessionVariables vars = new LeaveRequestControllerSessionVariables();
}

@{

    var grid = Html.DevExpress().GridView(settings =>
    {
        settings.Name = "LeaveRequestView";
        settings.CommandColumn.SetHeaderTemplateContent(c =>
        {
            Html.DevExpress().Button(hyperLinkSettings =>
            {
                hyperLinkSettings.Name = "link_" + settings.Name;
                hyperLinkSettings.Text = "Inserisci richiesta permesso";
                hyperLinkSettings.Width = Unit.Pixel(150);
                //hyperLinkSettings.NavigateUrl = "javascript:void(0);";
                hyperLinkSettings.ClientSideEvents.Click = string.Format(@"
        function(s, e)
        {{
            {0}.AddNewRow();
        }}
        ", settings.Name);
            }).Render();
        });


        settings.Settings.ShowFooter = true;
        settings.TotalSummary.Add(DevExpress.Data.SummaryItemType.Custom, "Id");

        Decimal totalWork = 0;

        settings.CustomSummaryCalculate = (sender, e) =>
        {
            ASPxSummaryItem summary = e.Item as ASPxSummaryItem;
            //if (summary.FieldName != "Quota") return;

            if (e.SummaryProcess == DevExpress.Data.CustomSummaryProcess.Start)
            {
                totalWork = 0;
            }
            if (e.SummaryProcess == DevExpress.Data.CustomSummaryProcess.Calculate)
            {
                totalWork += 1m; // Convert.ToDecimal(e.GetValue("Quota"));
            }
            if (e.SummaryProcess == DevExpress.Data.CustomSummaryProcess.Finalize)
            {
                e.TotalValue = "richieste totali:<br>" + totalWork.ToString("N2");
            }
        };

        settings.CallbackRouteValues = new { Controller = "LeaveRequest", Action = "LeaveRequestViewPartial" };

        settings.SettingsEditing.AddNewRowRouteValues = new { Controller = "LeaveRequest", Action = "LeaveRequestViewPartialAddNew" };
        settings.SettingsEditing.UpdateRowRouteValues = new { Controller = "LeaveRequest", Action = "LeaveRequestViewPartialUpdate" };
        settings.SettingsEditing.DeleteRowRouteValues = new { Controller = "LeaveRequest", Action = "LeaveRequestViewPartialDelete" };

        /*
        GridViewCommandColumnCustomButton btn = new GridViewCommandColumnCustomButton();
        btn.Image.Url = "~/Content/Images/check_icon.png";
        btn.Image.IsResourcePng = true;
        btn.Image.IconID = "Check";
        btn.Image.AlternateText = "Evadi ODP";
        btn.Styles.Style.Paddings.PaddingLeft = Unit.Pixel(30);

        settings.CommandColumn.CustomButtons.Add(btn);
        settings.ClientSideEvents.CustomButtonClick = "function(s, e) { document.location='" + DevExpressHelper.GetUrl(new { Controller = "LeaveRequestDetail", Action = "Index" }) + "?EvadiODP=' + s.GetRowKey(e.visibleIndex); }";
        */

        settings.SettingsEditing.Mode = GridViewEditingMode.PopupEditForm;
        settings.SettingsBehavior.ConfirmDelete = true;

        settings.CommandColumn.Visible = true;
        settings.CommandColumn.ShowNewButton = false;
        settings.CommandColumn.ShowDeleteButton = true;
        settings.CommandColumn.ShowEditButton = true;
        settings.CommandButtonInitialize = (s, e) =>
            {
                if (e.VisibleIndex == -1) return;
                if (e.ButtonType == ColumnCommandButtonType.Edit || e.ButtonType == ColumnCommandButtonType.Delete)
                {
                    object fieldValue = (s as MVCxGridView).GetRowValues(e.VisibleIndex, "Status");
                    e.Visible = (Convert.ToInt32(fieldValue) == 19);
                }

            };

        settings.SettingsCommandButton.EditButton.ButtonType = GridViewCommandButtonType.Button;
        settings.SettingsCommandButton.DeleteButton.ButtonType = GridViewCommandButtonType.Image;

        settings.SettingsText.ConfirmDelete = "Si vuole annullare questa richiesta? (non verrà fisicamente cancellata!)";

        settings.SettingsCommandButton.EditButton.Text = "Modifica richiesta";
        settings.SettingsCommandButton.DeleteButton.Text = "";
        settings.SettingsCommandButton.DeleteButton.Image.DescriptionUrl = "~/Content/Images/icon-trash-32.png";
        settings.SettingsCommandButton.DeleteButton.Image.IconID = "trash";
        settings.SettingsCommandButton.DeleteButton.Image.IsResourcePng = true;
        settings.SettingsCommandButton.DeleteButton.Image.Url = "~/Content/Images/icon-trash-32.png";

        settings.SettingsEditing.NewItemRowPosition = GridViewNewItemRowPosition.Top;


        settings.InitNewRow = (s, e) =>
        {
            e.NewValues["StatusDate"] = vars._currentDate;
            e.NewValues["ID_Applicant"] = vars._idUser;
            e.NewValues["ID_Manager"] = 18;
            ViewBag.IsNew = true;

        };

        settings.KeyFieldName = "ID";
        settings.SettingsPager.Visible = true;
        settings.SettingsPager.PageSize = 100;
        settings.Settings.ShowGroupPanel = false;
        settings.Settings.ShowFilterRow = false;
        settings.SettingsBehavior.AllowSelectByRowClick = false;
        settings.SettingsText.PopupEditFormCaption = "Nuova richiesta permesso";
        //settings.SettingsPopup.EditForm.Modal = true;

        settings.Columns.Add(column =>
        {
            column.FieldName = "ID";
            column.Caption = "ID";
            column.EditFormSettings.Visible = DefaultBoolean.True;

        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "LeaveType1.Description";
            column.Caption = "Tipo permesso";
            column.Visible = true;
            column.EditFormSettings.Visible = DefaultBoolean.False;
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "RequestDate";
            column.Caption = "Data richiesta";
            column.PropertiesEdit.DisplayFormatString = "dd/MM/yyyy";
            column.EditFormSettings.Visible = DefaultBoolean.False;

        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "StartDate";
            column.Caption = "Data inizio assenza";
            column.PropertiesEdit.DisplayFormatString = "dd/MM/yyyy";
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.CellStyle.Font.Bold = true;

        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "EndDate";
            column.Caption = "Data fine assenza";
            column.PropertiesEdit.DisplayFormatString = "dd/MM/yyyy";
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.CellStyle.Font.Bold = true;

        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "DayFraction1.Description";
            column.Caption = "Orario";
            column.Visible = true;
            column.EditFormSettings.Visible = DefaultBoolean.False;
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "VacationDays";
            column.Caption = "Giorni assenza";
            column.Visible = true;
            column.EditFormSettings.Visible = DefaultBoolean.False;
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "VacationHours";
            column.Caption = "Ore totali assenza";
            column.Visible = true;
            column.EditFormSettings.Visible = DefaultBoolean.False;
        });
        
        settings.Columns.Add(column =>
        {
            column.FieldName = "Employee1.UniqueName";
            column.Caption = "Richesta a";
            column.Visible = true;
            column.EditFormSettings.Visible = DefaultBoolean.False;
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "Statuse.Description";
            column.Caption = "Stato richiesta";
            column.Visible = true;
            column.EditFormSettings.Visible = DefaultBoolean.False;
            column.CellStyle.Font.Bold = true;
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "StatusDate";
            column.Caption = "il";
            column.PropertiesEdit.DisplayFormatString = "dd/MM/yyyy";
            column.EditFormSettings.Visible = DefaultBoolean.False;

        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "Employee2.UniqueName";
            column.Caption = "Approvata da";
            column.Visible = true;
            column.EditFormSettings.Visible = DefaultBoolean.False;
        });

        settings.Columns.Add(column =>
        {
            column.FieldName = "MessageToApplicant";
            column.Caption = "Comunicazioni da Direzione";
            column.Visible = true;
            column.EditFormSettings.Visible = DefaultBoolean.False;
        });


        //***********************************
        // EDIT CUSTOM FORM
        //***********************************

        settings.SetEditFormTemplateContent(c =>
        {
            Html.DevExpress().FormLayout(formLayoutSettings =>
            {
                formLayoutSettings.Name = "FormLayoutLeaveRequest";
                formLayoutSettings.Width = Unit.Pixel(Request.Browser.ScreenPixelsWidth);
                formLayoutSettings.Height = Unit.Pixel(Convert.ToInt32(Request.Browser.ScreenPixelsHeight / 2));
                formLayoutSettings.Width = Unit.Percentage(100);

                formLayoutSettings.ColCount = 2;


                formLayoutSettings.Items.Add(itemSettings =>
                {
                    itemSettings.FieldName = "LeaveType";
                    itemSettings.Caption = "Tipo permesso";
                    itemSettings.CaptionSettings.Location = LayoutItemCaptionLocation.Left;
                    itemSettings.ColSpan = 2;
                    itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.ComboBox;
                    var comboBoxSetings = (ComboBoxSettings)itemSettings.NestedExtensionSettings;
                    var vdata = from data in context.LeaveTypes
                                orderby data.ID
                                select new { ID = data.ID, Name = data.Description };
                    comboBoxSetings.Properties.DataSource = vdata.ToList();
                    comboBoxSetings.Properties.TextField = "Name";
                    comboBoxSetings.Properties.ValueField = "ID";
                    comboBoxSetings.Properties.ValueType = typeof(int);
                    comboBoxSetings.Width = Unit.Percentage(100);

                });

                formLayoutSettings.Items.Add(itemSettings =>
                {
                    itemSettings.FieldName = "StartDate";
                    itemSettings.Caption = "Data inizio assenza";
                    itemSettings.CaptionSettings.Location = LayoutItemCaptionLocation.Left;
                    itemSettings.ColSpan = 1;
                    itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.DateEdit;
                    var dateEditProperties = (DateEditSettings)itemSettings.NestedExtensionSettings;
                    dateEditProperties.Properties.EditFormatString = "dd/MM/yyyy";
                    dateEditProperties.Date = vars._currentDate;
                    dateEditProperties.Width = Unit.Pixel(250);
                });

                formLayoutSettings.Items.Add(itemSettings =>
                {
                    itemSettings.FieldName = "EndDate";
                    itemSettings.Caption = "Data fine assenza";
                    itemSettings.CaptionSettings.Location = LayoutItemCaptionLocation.Left;
                    itemSettings.ColSpan = 1;
                    itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.DateEdit;
                    var dateEditProperties = (DateEditSettings)itemSettings.NestedExtensionSettings;
                    dateEditProperties.Properties.EditFormatString = "dd/MM/yyyy";
                    dateEditProperties.Date = vars._currentDate;
                    dateEditProperties.Width = Unit.Pixel(250);
                });

                formLayoutSettings.Items.Add(itemSettings =>
                {
                    itemSettings.FieldName = "DayFraction";
                    itemSettings.Caption = "Orario";
                    itemSettings.CaptionSettings.Location = LayoutItemCaptionLocation.Left;
                    itemSettings.ColSpan = 1;
                    itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.ComboBox;
                    var comboBoxSetings = (ComboBoxSettings)itemSettings.NestedExtensionSettings;
                    var vdata = from data in context.DayFractions
                                orderby data.ID
                                select new { ID = data.ID, Name = data.Description };
                    comboBoxSetings.Properties.DataSource = vdata.ToList();
                    comboBoxSetings.Properties.TextField = "Name";
                    comboBoxSetings.Properties.ValueField = "ID";
                    comboBoxSetings.Properties.ValueType = typeof(int);
                    comboBoxSetings.Width = Unit.Percentage(100);

                });

                formLayoutSettings.Items.Add(itemSettings =>
                {
                    itemSettings.ColSpan = 1;
                    itemSettings.FieldName = "VacationDays";
                    itemSettings.Caption = "Giorni assenza";
                    itemSettings.CaptionSettings.Location = LayoutItemCaptionLocation.Left;
                    itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.TextBox;
                    var comboBoxSetings = (TextBoxSettings)itemSettings.NestedExtensionSettings;
                    comboBoxSetings.Width = Unit.Percentage(100);
                });

                formLayoutSettings.Items.Add(itemSettings =>
                {
                    itemSettings.ColSpan = 1;
                    itemSettings.FieldName = "VacationHours";
                    itemSettings.Caption = "Ore totali assenza (decimali)";
                    itemSettings.CaptionSettings.Location = LayoutItemCaptionLocation.Left;
                    itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.TextBox;
                    var comboBoxSetings = (TextBoxSettings)itemSettings.NestedExtensionSettings;
                    comboBoxSetings.Width = Unit.Percentage(100);
                });
                
                formLayoutSettings.Items.Add(itemSettings =>
                {
                    itemSettings.ColSpan = 2;
                    itemSettings.FieldName = "MessageToManager";
                    itemSettings.Caption = "Comunicazioni da richiedente";
                    itemSettings.CaptionSettings.Location = LayoutItemCaptionLocation.Top;
                    itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.Memo;
                    var comboBoxSetings = (MemoSettings)itemSettings.NestedExtensionSettings;
                    comboBoxSetings.Width = Unit.Percentage(100);
                    comboBoxSetings.Height = Unit.Pixel(50);
                });

                formLayoutSettings.Items.Add(itemSettings =>
                {
                    itemSettings.FieldName = "ID_Manager";
                    itemSettings.Caption = "Inviare a";
                    itemSettings.CaptionSettings.Location = LayoutItemCaptionLocation.Left;
                    itemSettings.ColSpan = 2;
                    itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.ComboBox;
                    var comboBoxSetings = (ComboBoxSettings)itemSettings.NestedExtensionSettings;
                    //var vdata = from data in context.Employees.Where(d => new int[] { 1, 18, 20 }.Contains(d.ID))
                    //            orderby data.ID
                    //            select new { ID = data.ID, Name = data.UniqueName };
                    //comboBoxSetings.Properties.TextField = "Name";
                    //comboBoxSetings.Properties.ValueField = "ID";
                    var vdata = new KeyValuePair<int, string>[] { new KeyValuePair<int, string>(18, "Direzione") };
                    comboBoxSetings.Properties.DataSource = vdata.ToList();
                    comboBoxSetings.Properties.TextField = "Value";
                    comboBoxSetings.Properties.ValueField = "key";
                    comboBoxSetings.Properties.ValueType = typeof(int);
                    comboBoxSetings.Width = Unit.Percentage(50);
                });

                formLayoutSettings.Items.Add(itemSettings =>
                {
                    itemSettings.ColSpan = 1;
                    itemSettings.FieldName = "Statuse.Description";
                    itemSettings.Caption = "Stato richiesta";
                    itemSettings.CaptionSettings.Location = LayoutItemCaptionLocation.Top;
                    itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.Label;
                    var comboBoxSetings = (LabelSettings)itemSettings.NestedExtensionSettings;
                    comboBoxSetings.Width = Unit.Percentage(50);
                    comboBoxSetings.Height = Unit.Pixel(50);
                    comboBoxSetings.ControlStyle.Font.Bold = true;
                });

                formLayoutSettings.Items.Add(itemSettings =>
                {
                    itemSettings.ColSpan = 1;
                    itemSettings.FieldName = "StatusDate";
                    itemSettings.Caption = "Aggiornamento";
                    itemSettings.CaptionSettings.Location = LayoutItemCaptionLocation.Top;
                    itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.Label;
                    var comboBoxSetings = (LabelSettings)itemSettings.NestedExtensionSettings;
                    comboBoxSetings.Width = Unit.Percentage(50);
                    comboBoxSetings.Height = Unit.Pixel(50);
                    comboBoxSetings.ControlStyle.Font.Bold = true;
                });

                formLayoutSettings.Items.Add(itemSettings =>
                {
                    itemSettings.ColSpan = 1;
                    itemSettings.FieldName = "Employee2.UniqueName";
                    itemSettings.Caption = "Approvata da";
                    itemSettings.CaptionSettings.Location = LayoutItemCaptionLocation.Top;
                    itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.Label;
                    var comboBoxSetings = (LabelSettings)itemSettings.NestedExtensionSettings;
                    comboBoxSetings.Width = Unit.Percentage(100);
                    comboBoxSetings.Height = Unit.Pixel(50);
                    comboBoxSetings.ControlStyle.Font.Bold = true;
                });

                formLayoutSettings.Items.Add(itemSettings =>
                {
                    itemSettings.ColSpan = 1;
                    itemSettings.FieldName = "MessageToApplicant";
                    itemSettings.Caption = "Comunicazioni da Direzione";
                    itemSettings.CaptionSettings.Location = LayoutItemCaptionLocation.Top;
                    itemSettings.NestedExtensionType = FormLayoutNestedExtensionItemType.Label;
                    var comboBoxSetings = (LabelSettings)itemSettings.NestedExtensionSettings;
                    comboBoxSetings.Width = Unit.Percentage(100);
                    comboBoxSetings.Height = Unit.Pixel(50);
                });

                formLayoutSettings.Items.AddEmptyItem();
                formLayoutSettings.Items.Add(itemSettings =>
                {
                    itemSettings.ShowCaption = DefaultBoolean.False;
                    itemSettings.ColSpan = 2;
                }).SetNestedContent(() =>
                {
                    ViewContext.Writer.Write("<div style='float:right'>");
                    Html.DevExpress().Button(
                        btnSettings =>
                        {
                            btnSettings.Name = "btnUpdateDT";
                            btnSettings.Text = "Invia richiesta";
                            btnSettings.ClientSideEvents.Click = "function(s, e){ LeaveRequestView.UpdateEdit(); }";
                        }).Render();
                    Html.DevExpress().Button(
                        btnSettings =>
                        {
                            btnSettings.Name = "btnCancelDT";
                            btnSettings.Text = "Annulla";
                            btnSettings.Style[HtmlTextWriterStyle.MarginLeft] = "5px";
                            btnSettings.ClientSideEvents.Click = "function(s, e){ LeaveRequestView.CancelEdit(); }";
                        }).Render();
                    ViewContext.Writer.Write("</div>");
                });
            })
            .Bind(ViewData["EditableLeaveRequest"] ?? c.DataItem)
            .Render();
        });

    });
    if (ViewData["EditError"] != null)
    {
        grid.SetEditErrorText((string)ViewData["EditError"]);
    }

}
@grid.Bind(Model).GetHtml()